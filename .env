# 安装路径
CLASH_BASE_DIR=~/.local/share/clashctl

# 机场订阅
CLASH_CONFIG_URL=

# 下载订阅时的 UserAgent
CLASH_SUB_UA=clash-verge/v2.4.0

# init 系统（自动识别）
INIT_TYPE=

# github 加速
URL_GH_PROXY=https://gh-proxy.org

# 公共 Web 控制台
URL_CLASH_UI=http://board.zash.run.place

# 软件版本
# 安装时优先解析 mihomo、yq、subconverter、zashboard 的最新 release tag
# 若获取失败，则回退到这里指定的版本
VERSION_MIHOMO=v1.19.17
VERSION_YQ=v4.49.2
VERSION_SUBCONVERTER=v0.9.0
VERSION_UI=v3.5.0
